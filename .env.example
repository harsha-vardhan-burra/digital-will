# Digital Will — Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# NEVER commit actual secret keys, production credentials, or master keys to source control.

# ==========================================
# Backend Configuration (Spring Boot)
# ==========================================
# Database Connection (PostgreSQL / Supabase in production; H2 in local dev profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/digitalwill
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Cryptographic Master Key (AES-256 Key Encryption Key)
# MUST be Base64 that decodes to exactly 32 bytes. Generate your own: openssl rand -base64 32
# This example value is public. Never use it for real data.
APP_CRYPTO_MASTER_KEY=hJ77iuvtLq5wbV2IIHUXL1b+UI2C7pqIuwUr8jKeVcs=

# Internal Scheduled Job Secret (Used by external trigger / GitHub Actions via X-Internal-Job-Secret header)
APP_JOBS_SECRET=digitalwill-internal-secret-token

# Notification Delivery Configuration (Optional: defaults to DISABLED for safe local execution)
# Providers: DISABLED (default, skips send), CONSOLE (local log formatting), RESEND (external API)
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_PROVIDER=DISABLED
NOTIFICATIONS_FROM_EMAIL=notifications@digitalwill.local
NOTIFICATIONS_API_KEY=your_resend_or_provider_api_key_here
APP_FRONTEND_URL=http://localhost:3000

# Server Port
SERVER_PORT=8080

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080